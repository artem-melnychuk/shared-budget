# Copy to .env and fill in. .env is gitignored.
TELEGRAM_BOT_TOKEN=

# The two members. KEY is what the database stores; TELEGRAM_ID is the numeric
# user id (several may be comma-separated); NAMES are Telegram display names,
# comma-separated, used when a forwarded message hides its author.
MEMBER_1_KEY=
MEMBER_1_TELEGRAM_ID=
MEMBER_1_NAMES=
MEMBER_2_KEY=
MEMBER_2_TELEGRAM_ID=
MEMBER_2_NAMES=

# Optional. SQLite file (default data/budget.db, gitignored) and the time zone
# for old chat exports that have no date_unixtime (default Europe/Paris).
BUDGET_DB=
BUDGET_TZ=

# Optional. Default split rule for reports, weights in member order: 50/50, 60/40...
BUDGET_SPLIT=
